{
    "name": "acerta-leads",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc --noemit && vite build",
        "preview": "vite preview --host",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier \"./src/**/*\" \"./src/*\" \"./*.json\" --write",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "src/**/*.{json,css,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@base-ui/react": "^1.4.1",
        "@fontsource-variable/source-sans-3": "^5.2.9",
        "@hookform/resolvers": "^5.2.2",
        "@tanstack/react-query": "^5.100.1",
        "@tanstack/react-router": "^1.168.23",
        "axios": "^1.15.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lucide-react": "^1.9.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-hook-form": "^7.73.1",
        "shadcn": "^4.4.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tw-animate-css": "^1.4.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.0",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^9.39.4",
        "@tailwindcss/vite": "^4.2.4",
        "@tanstack/eslint-plugin-query": "^5.100.1",
        "@tanstack/react-query-devtools": "^5.100.1",
        "@tanstack/router-devtools": "^1.166.13",
        "@tanstack/router-plugin": "^1.167.23",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "globals": "^17.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.7.3",
        "tailwindcss": "^4.2.4",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.58.2",
        "vite": "^8.0.10"
    }
}
